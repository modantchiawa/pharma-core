# Point d'entrée unique du serveur : HTTPS automatique (Let's Encrypt) quand SITE_ADDRESS est un
# nom de domaine, HTTP simple quand c'est ":80" (accès par adresse IP, recette interne).
{
	email {$ACME_EMAIL:noreply@localhost}
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# API, authentification, actuator et WebSocket STOMP vers le backend
	@backend path /api/* /ws/* /actuator/health /actuator/health/*
	handle @backend {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 120s
			}
		}
	}

	# PWA : fichiers statiques, repli sur index.html pour les routes Angular
	handle {
		root * /srv/web
		header /ngsw.json Cache-Control "no-cache, no-store, must-revalidate"
		header /ngsw-worker.js Cache-Control "no-cache, no-store, must-revalidate"
		header /index.html Cache-Control "no-cache"
		@immutable path_regexp \.(js|css|woff2|png|svg|ico)$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		header Permissions-Policy "camera=(self), geolocation=(self)"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}
