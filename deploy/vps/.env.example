# ---------------------------------------------------------------- adresse publique
# Nom de domaine pointant sur le VPS (HTTPS automatique) : SITE_ADDRESS=pharmacore.example.com
# Accès par adresse IP sans certificat (recette interne)    : SITE_ADDRESS=:80
SITE_ADDRESS=pharmacore.example.com
# URL complète telle que les navigateurs la verront (origine autorisée par l'API)
PUBLIC_URL=https://pharmacore.example.com
# Adresse e-mail pour Let's Encrypt (expiration des certificats)
ACME_EMAIL=admin@example.com
# Ports publiés sur la machine (test local : HTTP_PORT=8088 avec SITE_ADDRESS=:80 et PUBLIC_URL=http://localhost:8088)
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- base de données
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_MIGRATION_PASSWORD=change-me-too
DB_APP_PASSWORD=change-me-as-well
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=80
DB_POOL_SIZE=20

# ---------------------------------------------------------------- application
# demo : écran de connexion avec les comptes de test, données de démonstration chargées au premier
#        démarrage ; production : officines réelles, console éditeur par OpenID Connect
WEB_BUILD_CONFIG=demo
DEMO_ENABLED=true
DEMO_PLATFORM_PASSWORD=change-me-demo
DEMO_ACCOUNT_PASSWORD=Demo2026!
DEMO_PIN=1234
# Fournisseur d'identité de la console éditeur (production uniquement)
OIDC_PLATFORM_ISSUER=http://localhost:8180/realms/pharmacore-platform
OIDC_PHARMACY_ISSUER=http://localhost:8180/realms/pharmacore-pharmacies
INVOICE_CERTIFICATION=NONE
JAVA_RAM_PERCENT=60
TZ=Africa/Niamey
# Étiquette des images construites (renseignée par update.sh avec le commit git)
APP_VERSION=local

# ---------------------------------------------------------------- sauvegardes
BACKUP_DIR=/var/backups/pharmacore
BACKUP_KEEP_DAYS=14
# Copie distante facultative (rclone déjà configuré) : BACKUP_RCLONE_REMOTE=s3:pharmacore-backups
BACKUP_RCLONE_REMOTE=
